DB_URL=jdbc:postgresql://localhost:5432/food_delivery
DB_USER=your_database_user
DB_PASSWORD=your_database_password

JWT_SECRET=replace-with-a-secret-that-is-at-least-32-bytes-long
JWT_EXPIRATION_SECONDS=3600

# Optional: both values must be set together to create the initial admin account.
APP_ADMIN_EMAIL=
APP_ADMIN_PASSWORD=
